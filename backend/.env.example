PORT=3000
NODE_ENV=development

# PostgreSQL
DATABASE_URL=postgresql://postgres:password@localhost:5432/cemiapp

# JWT (kendi tokenlarımız için — Firebase tokenlarından bağımsız)
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=30d

# Firebase Admin SDK
# Firebase Console → Proje Ayarları → Hizmet Hesapları → Yeni özel anahtar oluştur
FIREBASE_PROJECT_ID=cemiapp-xxxxx
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@cemiapp-xxxxx.iam.gserviceaccount.com
# Private key'deki satır sonlarını \n olarak bırakın
FIREBASE_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\nMIIEowIBAAKCAQ...\n-----END RSA PRIVATE KEY-----\n"

# Cloudflare R2
# Cloudflare Dashboard → R2 → Manage R2 API Tokens
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=cemiapp-storage
# R2 bucket için public domain (Cloudflare → R2 → bucket → Settings → Public Access)
R2_PUBLIC_URL=https://storage.cemiapp.com
